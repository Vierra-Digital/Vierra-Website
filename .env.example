# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Generated from every process.env.* read in the app plus prisma/schema.prisma, so this is the
# complete surface rather than a hand-maintained subset. Anything marked "optional" leaves the
# feature dormant when unset rather than breaking the app.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Pooled connection the app runs on (Supabase pooler, port 6543).
DATABASE_URL=
# Direct connection (port 5432), used only for schema work. Optional: prisma.config.ts falls back to
# DATABASE_URL when it is unset, so every migrate / db-pull / studio command still runs. Set it
# anyway if you have it — DDL belongs on a direct connection rather than the pooler.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase auth and storage (required)
# ---------------------------------------------------------------------------
# Auth is Supabase Auth; the panel role is resolved from company membership on the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side fallback for the URL when the NEXT_PUBLIC_ one is absent.
SUPABASE_URL=
# Service-role key for the few writes a brand-new user has no RLS path for (client backfill,
# invitation auto-accept). Server only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage buckets. Optional — these default to blog-images / avatars / documents.
SUPABASE_STORAGE_BUCKET_BLOG=
SUPABASE_STORAGE_BUCKET_AVATARS=
SUPABASE_STORAGE_BUCKET_DOCS=

# ---------------------------------------------------------------------------
# Secrets and URLs (required)
# ---------------------------------------------------------------------------
# Base64 key encrypting stored third-party tokens.
ENCRYPTION_SECRET=
# Canonical app origin. NEXT_PUBLIC_APP_URL is what resolveBaseUrl prefers; APP_URL and
# NEXT_PUBLIC_SITE_URL are the fallbacks used by cron and tracking-link builders.
NEXT_PUBLIC_APP_URL=
APP_URL=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Google (required for login and the email panel)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------
# SMTP for password resets and onboarding session links.
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL=
FROM_NAME=
# Brevo is used in preference to SMTP when configured.
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Scheduled functions
# ---------------------------------------------------------------------------
# Shared secret guarding every */dispatch endpoint, sent as x-cron-secret or a bearer token.
# Compared with a timing-safe compare; when unset the endpoints reject all callers.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Email panel extras (all optional)
# ---------------------------------------------------------------------------
# Enables Gmail push for near-real-time inbound; the 5-minute poller covers it when unset.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
# Reply and high-intent alerts.
DISCORD_WEBHOOK_URL=
# Artemis AI (compose, reply, summarise, auto-draft). Dormant until set.
ANTHROPIC_API_KEY=
ARTEMIS_API_KEY=
ARTEMIS_BASE_URL=
ARTEMIS_MODEL=
ARTEMIS_PROVIDER=

# ---------------------------------------------------------------------------
# Billing (optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Dashboard "Website Visits" chart. Obtain the refresh token with `npm run connect-ga4`.
GA4_PROPERTY_ID=
GA4_OAUTH_REFRESH_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console meta verification.
GOOGLE_VERIFICATION=

# ---------------------------------------------------------------------------
# Social and ad platform connects (optional, per integration)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_COMPANY_CLIENT_ID=
LINKEDIN_COMPANY_CLIENT_SECRET=
LINKEDIN_COMPANY_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
GOOGLEADS_CLIENT_ID=
GOOGLEADS_CLIENT_SECRET=
GOOGLEADS_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Meetings (optional)
# ---------------------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
MSTEAMS_CLIENT_ID=
MSTEAMS_CLIENT_SECRET=
MSTEAMS_TENANT_ID=
MSTEAMS_WEBHOOK_CLIENT_STATE=

# ---------------------------------------------------------------------------
# Campaigns (optional)
# ---------------------------------------------------------------------------
SMARTLEAD_API_KEY=
SMARTLEAD_BASE_URL=
SMARTLEAD_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Careers uploads (optional — the form accepts no files without these)
# ---------------------------------------------------------------------------
CAREERS_DRIVE_REFRESH_TOKEN=
CAREERS_DRIVE_ROOT_FOLDER_ID=
CAREERS_DRIVE_FOLDERS=

# ---------------------------------------------------------------------------
# Browser extension (optional)
# ---------------------------------------------------------------------------
# The extension runs on linkedin.com and cannot use the session cookie, so it authenticates with
# this shared secret and bumps the tracker for the user/company named here.
EXTENSION_TRACK_TOKEN=
EXTENSION_TRACK_USER_ID=
EXTENSION_TRACK_COMPANY_ID=

# ---------------------------------------------------------------------------
# Content research (optional)
# ---------------------------------------------------------------------------
MANUS_API_KEY=
MANUS_API_URL=
MANUS_API_BASE_URL=
MANUS_MODEL=
MANUS_CREATE_JOB_PATH=
MANUS_STATUS_PATH_TEMPLATE=
MANUS_ENABLE_CHAT_FALLBACK=
MANUS_LOG_REQUESTS=
MANUS_TASK_MAX_POLLS=
MANUS_TASK_POLL_MS=
ANSWER_THE_PUBLIC_BRIDGE_URL=
ANSWER_THE_PUBLIC_BRIDGE_TOKEN=

# ---------------------------------------------------------------------------
# Analytics licence check (optional)
# ---------------------------------------------------------------------------
# The self-hosted validation service behind /api/analytics/validate. All three must be set or the
# endpoint reports "not_configured" and makes no upstream call. These used to be hardcoded in the
# route, so the previously committed key should be treated as compromised and rotated.
ANALYTICS_VALIDATE_URL=
ANALYTICS_VALIDATE_KEY=
ANALYTICS_VALIDATE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Misc (optional)
# ---------------------------------------------------------------------------
# Days a document signing link stays valid. Defaults to 30.
SIGNING_LINK_TTL_DAYS=
