  attendee_count      Int?
  duration_seconds    Int?
  held_at             DateTime?             @db.Timestamptz(6)
  // automatic | csv_import | manual_override — how attendance_status was last set.
  attendance_source   String?
  campaign_contact_id String?               @db.Uuid
  // Team-link claim queue (Phase 3). status='slot_claimed' means the prospect picked a time on
  // a team BookingLink but no host is paired yet; claimed_by_user_id is set once someone claims
  // it (manually or via the round-robin auto-assign job) and status moves to 'confirmed'.
  claimed_by_user_id  String?               @db.Uuid
  // Snapshot of the claimed host's email at claim/reassignment time — survives the users row
  // being deleted, so the meeting record always shows who took it (see reassign.ts, claimSlot.ts).
  claimed_by_user_email String?
  claim_deadline_at   DateTime?             @db.Timestamptz(6)
  reminder_sent_at    DateTime?             @db.Timestamptz(6)
  // Set once the 1-year retention job (or a manual erasure request) has nulled out invitee_name/
  // invitee_email/attendee_emails on this row — scheduled_end/status/aggregate counts are kept
  // for analytics. Presence of this timestamp is the idempotency marker (see lib/booking/retention.ts).
  pii_erased_at       DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  booking_links       BookingLink           @relation(fields: [booking_link_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign_contacts   CampaignContact?      @relation(fields: [campaign_contact_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users_bookings_claimed_by_user_idTousers User? @relation("bookings_claimed_by_user_idTousers", fields: [claimed_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  booking_status_events       BookingStatusEvent[]
  booking_reschedule_events   BookingRescheduleEvent[]
  booking_reassignment_events BookingReassignmentEvent[]

  @@map("bookings")
  @@index([booking_link_id], map: "idx_bookings_link_id")
  @@index([campaign_contact_id], map: "idx_bookings_campaign_contact_id")
  @@index([status, claim_deadline_at], map: "idx_bookings_claim_deadline")
  @@schema("public")
}

// Audit log for team-link reassignment (either the current host or a company admin can
// approve — see pages/api/booking/[id]/reassign.ts). Always written, even though a
// reassignment resets round-robin fairness as if the original claim never happened.
model BookingReassignmentEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id         String   @db.Uuid
  from_user_id       String?  @db.Uuid
  to_user_id         String?  @db.Uuid
  approved_by_user_id String? @db.Uuid
  // Email snapshots so the audit log still shows who was involved after a users row is deleted
  // (to_user_id/from_user_id/approved_by_user_id all go SET NULL on delete — see reassign.ts).
  from_user_email        String?
  to_user_email          String?
  approved_by_user_email String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  bookings                                                      Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_booking_reassignment_events_from_user_idTousers         User?   @relation("booking_reassignment_events_from_user_idTousers", fields: [from_user_id], references: [id], onUpdate: NoAction)
  users_booking_reassignment_events_to_user_idTousers           User?   @relation("booking_reassignment_events_to_user_idTousers", fields: [to_user_id], references: [id], onUpdate: NoAction)
  users_booking_reassignment_events_approved_by_user_idTousers  User?   @relation("booking_reassignment_events_approved_by_user_idTousers", fields: [approved_by_user_id], references: [id], onUpdate: NoAction)

  @@map("booking_reassignment_events")
  @@index([booking_id], map: "idx_booking_reassignment_events_booking_id")
  @@schema("public")
}

// Audit log for manual attendance_status overrides — mirrors lead_status_events.
model BookingStatusEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id         String   @db.Uuid
  from_status        String?
  to_status          String
  changed_by_user_id String?  @db.Uuid
  // Snapshot of the reviewer's email so the audit trail still shows who made the override
  // after that users row is deleted (changed_by_user_id goes SET NULL — see attendance.ts).
  changed_by_user_email String?
  note               String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  users              User?    @relation(fields: [changed_by_user_id], references: [id], onUpdate: NoAction)
  bookings           Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("booking_status_events")
  @@index([booking_id], map: "idx_booking_status_events_booking_id")
  @@schema("public")
}

// Reschedule log — mutates Booking.start_at/end_at in place; this is the history.
model BookingRescheduleEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id        String   @db.Uuid
  previous_start_at DateTime @db.Timestamptz(6)
  new_start_at      DateTime @db.Timestamptz(6)
  // host | prospect
  rescheduled_by    String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  bookings          Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("booking_reschedule_events")
  @@index([booking_id], map: "idx_booking_reschedule_events_booking_id")
  @@schema("public")
}

// LinkedIn unified inbox — synced by the Sales Nav extension (per user: staff see their own
// LinkedIn, clients theirs). See docs/LINKEDIN_UNIFIED_INBOX_PLAN.md.
// Shared-inbox delegation: an admin grants a user read (implied) + optional send access to
// another mailbox (any connected account — Gmail or domain SMTP). Enforcement resolves a
// user's accessible mailboxes = owned + granted. See lib/email/mailboxAccess.ts.
model MailboxGrant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String   @db.Uuid
  grantee_user_id String   @db.Uuid
  account_email   String
  can_send        Boolean  @default(true)
  granted_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("mailbox_grants")
  @@unique([grantee_user_id, account_email], map: "uq_mailbox_grants")
  @@index([company_id], map: "idx_mailbox_grants_company")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Campaigns (automatic email sending). These models mirror the tables that ALREADY
// EXIST in the live DB (created out-of-band with the old campaigns work). See
// docs/CAMPAIGNS_PLAN.md. The campaign engine/UI (from branch 04654dc) can be built
// against these; not yet wired to sending code on master.
// ---------------------------------------------------------------------------

model Campaign {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String               @db.Uuid
  account_id              String               @db.Uuid
  created_by              String?              @db.Uuid
  name                    String
  status                  String               @default("draft")
  audience_filter         Json?                @db.JsonB
  audience_synced_at      DateTime?            @db.Timestamptz(6)
  send_delay_seconds      Int                  @default(60)
  send_jitter_seconds     Int                  @default(30)
  daily_send_limit        Int                  @default(50)
  enroll_on_signal        Boolean              @default(false)
  scheduled_start_at      DateTime?            @db.Timestamptz(6)
  started_at              DateTime?            @db.Timestamptz(6)
  completed_at            DateTime?            @db.Timestamptz(6)
  paused_at               DateTime?            @db.Timestamptz(6)
  // "internal" (local SMTP send via sendQueueTick.ts) | "smartlead" (Smartlead owns send
  // execution; see .claude/schema_v2_campaigns_smartlead_integration.md) | "brevo" (temporary
  // stopgap — sendQueueTick.ts still owns pacing/sequencing, only the transport call forks; see
  // .claude/schema_v2_campaigns_brevo_integration.md). Per-campaign, not global — set at
  // creation and immutable after first launch (no mid-campaign migration).
  send_provider           String               @default("internal")
  // Set once this campaign is first mirrored into Smartlead via POST /campaigns.
  smartlead_campaign_id   String?
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime             @default(now()) @db.Timestamptz(6)
  campaign_steps          CampaignStep[]
  campaign_contacts       CampaignContact[]
  campaign_daily_stats    CampaignDailyStat[]
  email_provider_accounts EmailProviderAccount @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("campaigns")
  @@schema("public")
}

model CampaignStep {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id        String             @db.Uuid
  step_order         Int
  name               String?
  template_id        String?            @db.Uuid
  subject_override   String?
  body_html_override String?
  body_text_override String?
  delay_days         Int                @default(0)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  campaigns          Campaign           @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email_templates    EmailTemplate?     @relation(fields: [template_id], references: [id], onUpdate: NoAction)
  campaign_step_sends CampaignStepSend[]

  @@map("campaign_steps")
  @@schema("public")
}

model CampaignContact {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id         String             @db.Uuid
  contact_id          String?            @db.Uuid
  contact_email       String
  contact_first_name  String?
  contact_last_name   String?
  contact_business    String?
  assigned_to         String?            @db.Uuid
  current_step_id     String?            @db.Uuid
  lead_status         String             @default("no_response")
  queue_status        String             @default("queued")
  skip_reason         String?
  enrolled_at         DateTime           @default(now()) @db.Timestamptz(6)
  next_send_at        DateTime?          @db.Timestamptz(6)
  last_sent_at        DateTime?          @db.Timestamptz(6)
  completed_at        DateTime?          @db.Timestamptz(6)
  // Maps this contact to its Smartlead lead record, for correlating inbound webhook events
  // back to the right row. Null for "internal"-provider campaigns.
  smartlead_lead_id   String?
  // Stable, unguessable token for this contact's one-click unsubscribe link (footer +
  // List-Unsubscribe header) — generated once on first send, reused across every sequence step
  // so the link/header stays valid for the life of the campaign. Null until the first send.
  unsubscribe_token   String?            @unique
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @db.Timestamptz(6)
  campaigns           Campaign           @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign_step_sends CampaignStepSend[]
  bookings            Booking[]

  @@map("campaign_contacts")
  @@schema("public")
}

model CampaignStepSend {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_contact_id String          @db.Uuid
  step_id             String          @db.Uuid
  status              String          @default("pending")
  scheduled_at        DateTime        @db.Timestamptz(6)
  rendered_subject    String?
  rendered_body_html  String?
  rendered_body_text  String?
  outbound_message_id String?         @db.Uuid
  attempted_at        DateTime?       @db.Timestamptz(6)
  sent_at             DateTime?       @db.Timestamptz(6)
  failed_at           DateTime?       @db.Timestamptz(6)
  fail_reason         String?
  retry_count         Int             @default(0)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  campaign_contacts   CampaignContact @relation(fields: [campaign_contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign_steps      CampaignStep    @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("campaign_step_sends")
  @@unique([campaign_contact_id, step_id], map: "uq_campaign_step_sends_contact_step")
  @@schema("public")
}

model CampaignDailyStat {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id  String   @db.Uuid
  date         DateTime @db.Date
  emails_sent  Int      @default(0)
