// Dedup log for the Smartlead webhook receiver (pages/api/campaigns/webhooks/smartlead.ts).
// Smartlead's own retry behavior means the same event can arrive more than once; smartlead_request_id
// is their X-Request-Id header, used to skip re-processing an already-handled event.
model SmartleadWebhookEvent {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  smartlead_request_id  String   @unique
  event_type            String
  received_at           DateTime @default(now()) @db.Timestamptz(6)

  @@map("smartlead_webhook_events")
  @@schema("public")
}

// Dedup log for the Brevo webhook receiver. Unlike Smartlead's X-Request-Id, Brevo's payload has
// no confirmed single unique-per-event id, so dedupe on a composite key instead — see
// .claude/schema_v2_campaigns_brevo_integration.md §3/§5.
model BrevoWebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupe_key  String   @unique
  event_type  String
  received_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("brevo_webhook_events")
  @@schema("public")
}

