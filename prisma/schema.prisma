  @@map("campaign_daily_stats")
  @@unique([campaign_id, date], map: "uq_campaign_daily_stats")
  @@schema("public")
}

model LeadStatusEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_contact_id String   @db.Uuid
  from_status         String?
  to_status           String
  changed_by_user_id  String?  @db.Uuid
